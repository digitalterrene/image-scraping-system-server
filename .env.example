# Directory where scraped images are stored locally.
# On Vercel serverless environments, defaults to /tmp/scraped_images when unset.
SCRAPED_IMAGES_DIR=scraped_images

# Optional public base URL prefix for returned image links (e.g. https://api.example.com/api/v1/images).
# Leave empty to derive dynamically from the incoming HTTP request Host header.
BASE_URL=

# HTTP request timeout (seconds) for webpage fetches and image downloads.
REQUEST_TIMEOUT_SECONDS=15.0

# Maximum number of concurrent image downloads per scrape request.
MAX_CONCURRENT_DOWNLOADS=10

# Maximum allowed size (bytes) per downloaded image (default: 10 MiB).
MAX_IMAGE_SIZE_BYTES=10485760

# Maximum number of images processed per scrape request.
MAX_IMAGES_PER_SCRAPE=50

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=*

# Custom User-Agent header sent during scraping requests.
SCRAPER_USER_AGENT=ImageScrapingSystem/2.0 (+https://github.com/digitalterrene/image-scraping-system-server)
